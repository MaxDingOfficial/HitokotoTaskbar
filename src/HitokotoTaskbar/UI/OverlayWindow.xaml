<Window x:Class="HitokotoTaskbar.UI.OverlayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hitokoto Taskbar" WindowStyle="None" AllowsTransparency="True"
 Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
 ResizeMode="NoResize" Focusable="False" Topmost="True" Width="1" Height="1"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <!-- Zero-alpha pixels pass through this layered window. Only rendered glyphs are
      clickable; no transparent full-taskbar input surface is created. -->
 <Border x:Name="HitSurface" Background="Transparent" Padding="1,0" Cursor="Hand"
         MouseLeftButtonUp="OnNext" MouseRightButtonUp="OnMenu">
  <TextBlock x:Name="QuoteText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
             VerticalAlignment="Center" FontWeight="Normal" Focusable="False">
   <TextBlock.ToolTip>
    <ToolTip Placement="Top" HasDropShadow="True" Focusable="False">
     <TextBlock x:Name="TooltipText" MaxWidth="440" TextWrapping="Wrap" FontSize="13" />
    </ToolTip>
   </TextBlock.ToolTip>
  </TextBlock>
 </Border>
</Window>
